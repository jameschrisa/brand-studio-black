# Add a key for each provider you want to offer. Providers without a key are hidden in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (quick = fast pass, deep = richer read)
CLAUDE_QUICK_MODEL=claude-haiku-5-5
CLAUDE_DEEP_MODEL=claude-sonnet-5-5
OPENAI_QUICK_MODEL=gpt-5.5
OPENAI_DEEP_MODEL=gpt-5.5
KIMI_QUICK_MODEL=kimi-k3.1-pro-highspeed
KIMI_DEEP_MODEL=kimi-k3.1-pro
OPENROUTER_QUICK_MODEL=google/gemini-3.8-flash
OPENROUTER_DEEP_MODEL=google/gemini-4-argon
# Use https://api.moonshot.cn/v1 for China-region Moonshot keys
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Strongly recommended once deployed: anyone calling /api/analyze must send this key.
ACCESS_KEY=

# Render a real screenshot when analyzing a URL (uses headless Chromium).
ENABLE_SCREENSHOT=true
# Local only: path to your installed Chrome, e.g. on macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
